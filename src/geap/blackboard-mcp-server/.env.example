# Copy to .env (git-ignored) and fill in. Nothing here is committed.

# Blackboard Learn instance base URL, no trailing slash.
# e.g. https://yourinstitution.blackboard.com
BLACKBOARD_BASE_URL=

# LOCAL/DEV ONLY: a pre-generated Blackboard access token, used when there's no
# Authorization header (e.g. testing with scripts/call_tool.py or stdio).
# Leave EMPTY in production — Gemini Enterprise forwards each user's token in the
# request header, and that per-user token is what the server uses.
BLACKBOARD_ACCESS_TOKEN=

# Server settings
MCP_PATH=/mcp
GRADING_BATCH_SIZE=5

# NOTE: OAuth Client ID / Secret and the Authorization / Token URLs are NOT set
# here. They live in the Gemini Enterprise connector config. GE performs the
# OAuth flow and forwards the resulting per-user Blackboard token to this server.
