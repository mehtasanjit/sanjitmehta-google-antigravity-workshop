# Copy to agent/.env and adjust.

# --- Model auth: pick ONE ---
# Option A — Vertex AI (GCP; uses Application Default Credentials)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=<YOUR_PROJECT_ID>
GOOGLE_CLOUD_LOCATION=<YOUR_REGION>

# Option B — Google AI Studio API key (comment out the Vertex lines above)
# GOOGLE_API_KEY=your-api-key

# --- Agent wiring ---
MCP_URL=<YOUR_MCP_URL>/mcp
MODEL=gemini-2.5-flash

# Optional fallback token for `adk web` (run.py injects per-user tokens itself).
# USER_JWT=
