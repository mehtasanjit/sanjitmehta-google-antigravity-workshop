{
  "mcpServers": {
    "GmailMcp": {
      "command": "node",
      "args": [
        "/ABSOLUTE/PATH/TO/src/geap/gmail-mcp-server-stdio/server.js"
      ],
      "env": {
        "GMAIL_CLIENT_ID": "YOUR_OAUTH_CLIENT_ID.apps.googleusercontent.com",
        "GMAIL_CLIENT_SECRET": "YOUR_OAUTH_CLIENT_SECRET",
        "GMAIL_MCP_AUTO_POPUP": "1"
      }
    }
  }
}
